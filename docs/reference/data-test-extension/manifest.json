{
  "manifest_version": 3,
  "name": "Token Pet data test",
  "version": "0.1.0",
  "description": "Throwaway test: can an extension read Claude plan usage, from a tab and from the background?",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://claude.ai/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Token Pet data test"
  }
}

{
  "name": "pixiu",
  "version": "0.3.0",
  "private": true,
  "description": "A Chrome extension that shows your Claude plan usage as a virtual pet.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:debug": "wxt build --mode debug",
    "artboards": "wxt build --mode debug && node scripts/artboards.mjs",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource/jersey-15": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
